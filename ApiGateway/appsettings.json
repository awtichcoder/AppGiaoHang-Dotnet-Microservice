{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "HealthTimeoutSeconds": 5
  },
  "ReverseProxy": {
    "Routes": {
      "identity-root": { "ClusterId": "identity", "Match": { "Path": "/api/identity" } },
      "identity": { "ClusterId": "identity", "Match": { "Path": "/api/identity/{**catch-all}" } },
      "driver-root": { "ClusterId": "driver", "Match": { "Path": "/api/driver" } },
      "driver": { "ClusterId": "driver", "Match": { "Path": "/api/driver/{**catch-all}" } },
      "order-root": { "ClusterId": "order", "Match": { "Path": "/api/order", "Methods": [ "GET", "POST" ] } },
      "order": { "ClusterId": "order", "Match": { "Path": "/api/order/{**catch-all}" } },
      "delivery-root": { "ClusterId": "delivery", "Match": { "Path": "/api/delivery" } },
      "delivery": { "ClusterId": "delivery", "Match": { "Path": "/api/delivery/{**catch-all}" } },
      "map-root": { "ClusterId": "map", "Match": { "Path": "/api/map" } },
      "map": { "ClusterId": "map", "Match": { "Path": "/api/map/{**catch-all}" } },
      "promotion-root": { "ClusterId": "promotion", "Match": { "Path": "/api/promotion" } },
      "promotion": { "ClusterId": "promotion", "Match": { "Path": "/api/promotion/{**catch-all}" } },
      "loyalty-root": { "ClusterId": "loyalty", "Match": { "Path": "/api/loyalty" } },
      "loyalty": { "ClusterId": "loyalty", "Match": { "Path": "/api/loyalty/{**catch-all}" } },

      "health-identity": { "ClusterId": "identity", "Match": { "Path": "/health/identity/{**catch-all}" }, "Transforms": [ { "PathPattern": "/health/{**catch-all}" } ] },
      "health-delivery": { "ClusterId": "delivery", "Match": { "Path": "/health/delivery/{**catch-all}" }, "Transforms": [ { "PathPattern": "/health/{**catch-all}" } ] },
      "health-driver": { "ClusterId": "driver", "Match": { "Path": "/health/driver/{**catch-all}" }, "Transforms": [ { "PathPattern": "/health/{**catch-all}" } ] },
      "health-loyalty": { "ClusterId": "loyalty", "Match": { "Path": "/health/loyalty/{**catch-all}" }, "Transforms": [ { "PathPattern": "/health/{**catch-all}" } ] },
      "health-map": { "ClusterId": "map", "Match": { "Path": "/health/map/{**catch-all}" }, "Transforms": [ { "PathPattern": "/health/{**catch-all}" } ] },
      "health-order": { "ClusterId": "order", "Match": { "Path": "/health/order/{**catch-all}" }, "Transforms": [ { "PathPattern": "/health/{**catch-all}" } ] },
      "health-promotion": { "ClusterId": "promotion", "Match": { "Path": "/health/promotion/{**catch-all}" }, "Transforms": [ { "PathPattern": "/health/{**catch-all}" } ] }
    },
    "Clusters": {
      "identity": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "service": { "Address": "http://localhost:6203/" } }
      },
      "delivery": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "service": { "Address": "http://localhost:6201/" } }
      },
      "driver": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "service": { "Address": "http://localhost:6202/" } }
      },
      "loyalty": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "service": { "Address": "http://localhost:6204/" } }
      },
      "map": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "service": { "Address": "http://localhost:6205/" } }
      },
      "order": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "service": { "Address": "http://localhost:6206/" } }
      },
      "promotion": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "service": { "Address": "http://localhost:6207/" } }
      }
    }
  }
}
